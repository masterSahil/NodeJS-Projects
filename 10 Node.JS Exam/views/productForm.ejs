<%- include('partials/navbar') %>

<main class="page">
    <section class="hero" style="border-bottom: 1px solid var(--border); padding-bottom: 24px; margin-bottom: 32px;">
        <div>
            <h1 style="font-size: 1.75rem;"><%= product ? 'Edit Product' : 'Add Product' %></h1>
            <p class="subtle">Add the name, price, category, and a photo that makes the product easy to recognize.</p>
        </div>
        <a class="button" href="/products" style="padding: 10px 20px;">Cancel</a>
    </section>

    <form action="<%= product ? `/product/edit/${product._id}` : '/product/add' %>" method="POST" enctype="multipart/form-data">
        <div class="two-column" style="display: grid; grid-template-columns: 2fr 1fr; gap: 48px; align-items: start;">
            
            <div class="form-panel" style="background: var(--surface); padding: 40px; border-radius: var(--radius-md); border: 1px solid var(--border); box-shadow: var(--shadow-sm);">
                <div class="form-group" style="margin-bottom: 32px;">
                    <label style="font-size: 1rem; margin-bottom: 8px;">Product Title</label>
                    <input type="text" name="name" value="<%= product ? product.name : '' %>" placeholder="Example: Spicy Paneer Wrap" required style="padding: 14px;">
                </div>

                <div style="display: flex; gap: 24px;">
                    <div class="form-group" style="flex: 1;">
                        <label style="font-size: 1rem; margin-bottom: 8px;">Price ($)</label>
                        <input type="number" name="price" min="0" step="0.01" value="<%= product ? product.price : '' %>" required style="padding: 14px;">
                    </div>

                    <div class="form-group" style="flex: 1;">
                        <label style="font-size: 1rem; margin-bottom: 8px;">Category</label>
                        <select name="category" required style="padding: 14px;">
                            <option value="" disabled <%= !product ? 'selected' : '' %>>Select a category</option>
                            <% categories.forEach(cat => { %>
                                <option value="<%= cat._id %>" <%= product && product.category && product.category.toString() === cat._id.toString() ? 'selected' : '' %>><%= cat.name %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>
            </div>

            <div>
                <div class="form-panel" style="background: var(--surface); padding: 32px; border-radius: var(--radius-md); border: 1px solid var(--border); margin-bottom: 24px; box-shadow: var(--shadow-sm);">
                    <label style="font-size: 1rem; margin-bottom: 12px; display: block;">Product Image</label>
                    
                    <input type="file" name="image" accept="image/*" id="imageInput"  <%= !product ? 'required' : '' %> >
                </div>

                <button class="button primary" type="submit" style="width: 100%; padding: 16px; font-size: 1.15rem; font-weight: 700; box-shadow: 0 4px 6px -1px rgba(217, 70, 103, 0.3);"><%= product ? 'Update Product' : 'Save Product' %></button>
            </div>
        </div>
    </form>
</main>
</body>
</html>
