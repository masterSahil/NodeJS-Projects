<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Books | Book Store</title>
    <script src="https://unpkg.com/lucide@latest"></script>
    <link rel="stylesheet" href="/assets/css/manage.css">
</head>
<body>
<%- include('navbar') -%>
<div class="container">
    <h2>📚 Manage Books</h2>
    <% if (books.length > 0) { %>
    <table>
        <thead>
            <tr>
                <th>Cover</th>
                <th>Title</th>
                <th>Author</th>
                <th>Category</th>
                <th>Price</th>
                <th>Qty</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            <% books.forEach(book => { %>
                <tr>
                    <td>
                        <img src="/uploads/<%= book.cover %>" />
                    </td>

                    <td><%= book.title %></td>
                    <td><%= book.author %></td>
                    <td><%= book.category %></td>
                    <td>₹ <%= book.price %></td>
                    <td><%= book.quantity %></td>

                    <td>
                        <a href="/edit/<%= book._id %>" class="btn edit"> Edit </a>
                        <a class="btn delete" onclick="deleteBook('<%= book._id %>')" > Delete </a>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
    <% } else { %>
    <div class="empty-state">
        <div class="empty-box">
            <i data-lucide="book-x" class="empty-icon"></i>

            <h2>No Books Yet</h2>
            <p>Your library is empty. Start by adding your first book.</p>

            <a href="/add" class="empty-btn">
                <i data-lucide="plus-circle"></i>
                Add First Book
            </a>
        </div>
    </div>
    <% } %>
</div>
<%- include('footer') -%>

<script src="/assets/js/lucide.js"></script>
<script>
    async function deleteBook(id) {
        if (!confirm("Are you sure you want to delete?")) return;

        try {
            const res = await fetch(`/api/books/${id}`, { method: "DELETE" });
            const data = await res.json();

            if (data.success) {
                alert("Deleted Successfully");
                location.reload();
            } else {
                alert("Failed to delete");
            }
        } catch (error) {
            console.error(error);
            alert("Error occurred");
        }
    }
</script>
</body>
</html>