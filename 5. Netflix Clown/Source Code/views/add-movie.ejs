<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Add Movie</title>
  <link rel="stylesheet" href="/assets/css/add-movie.css" />
</head>
<body>
    <%- include('header') -%>
    <div class="form-wrapper">
        <div class="form-card">
            <h1>🎬 Add New Movie</h1>
            <form action="/api/movies" method="POST" enctype="multipart/form-data">
                <div class="form-section">
                    <h3>Basic Info</h3>

                    <div class="grid-2">
                    <div class="form-group">
                        <label>Title</label>
                        <input type="text" name="title" required />
                    </div>

                    <div class="form-group">
                        <label>Release Year</label>
                        <input type="number" name="year" required />
                    </div>
                    </div>

                    <div class="grid-2">
                    <div class="form-group">
                        <label>Genre</label>
                        <input type="text" name="genre" required />
                    </div>

                    <div class="form-group">
                        <label>Director</label>
                        <input type="text" name="director" required />
                    </div>
                    </div>
                </div>

                <div class="form-section">
                    <h3>Details</h3>

                    <div class="grid-2">
                    <div class="form-group">
                        <label>Rating</label>
                        <input type="number" step="0.1" name="rating" min="0" max="10" required />
                    </div>

                    <div class="form-group">
                        <label>Duration (min)</label>
                        <input type="number" name="duration" required />
                    </div>
                    </div>
                </div>

                <div class="form-section">
                    <h3>Media</h3>

                    <div class="form-group">
                        <label>Upload Poster</label>
                        <input type="file" name="poster" accept="image/*" required />
                    </div>

                    <div class="form-group">
                    <label>Description</label>
                    <textarea name="description" rows="4" required></textarea>
                    </div>
                </div>

                <button class="submit-btn">Add Movie</button>
            </form>
        </div>
    </div>
    <%- include('footer.ejs') -%>
</body>
</html>